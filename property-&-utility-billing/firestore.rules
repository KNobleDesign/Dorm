rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master settings and property configuration
    match /dorm_config/{document=**} {
      allow read, write: if true;
    }
    
    // Buildings collection
    match /buildings/{buildingId} {
      allow read, write: if true;
    }
    
    // Monthly billing & room meter records
    match /monthly_records/{monthKey} {
      allow read, write: if true;
    }
    
    // Operating expenses collection
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    
    // App users and administrators
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Unified dormitory metadata bundle
    match /dormitory/{docId} {
      allow read, write: if true;
    }
    
    // Automated health check ping testing
    match /_health_check/{docId} {
      allow read, write: if true;
    }

    // Default fallback rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
